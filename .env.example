# ============================================================================
#  溯文 SeekLit —— 配置样例
#  复制为 .env 后按需修改；所有项都有代码内默认值，留空即用默认。
#  cp .env.example .env
# ============================================================================

# ---- seekdb 连接（MySQL 协议）----
SEEKDB_HOST=127.0.0.1
SEEKDB_PORT=10100
SEEKDB_USER=root@sys
SEEKDB_PASSWORD=
SEEKDB_DATABASE=seeklit
# 单条 SQL 超时（微秒）。混合检索带窗口函数，默认 100s 足够。
SEEKDB_QUERY_TIMEOUT=100000000

# ---- 向量化后端 ----
# lsa   = 默认。离线 TF-IDF + 随机化截断 SVD，纯 numpy，不联网不下模型
# ollama / sentence_transformers / openai = 神经嵌入，改这里即可切换
EMBED_BACKEND=lsa
EMBED_DIM=256

# LSA 参数
LSA_MIN_DF=2
LSA_MAX_FEATURES=20000
# LSA_MODEL_PATH=

# 切换神经后端时的示例（取消注释即可）
# EMBED_BACKEND=ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_EMBED_MODEL=bge-m3
# EMBED_BACKEND=openai
# OPENAI_BASE_URL=https://api.example.com/v1
# OPENAI_API_KEY=sk-xxx
# OPENAI_EMBED_MODEL=text-embedding-3-small
# EMBED_BACKEND=sentence_transformers
# ST_MODEL_PATH=BAAI/bge-small-zh-v1.5
# ST_DEVICE=cpu

# ---- 分块 ----
CHUNK_TARGET_CHARS=520
CHUNK_MAX_CHARS=900
CHUNK_OVERLAP_CHARS=80
PDF_MAX_PAGES=0
EMBED_BATCH_SIZE=32
DB_INSERT_BATCH=200

# ---- 检索 ----
SEARCH_TOP_K=8
SEARCH_CANDIDATE_K=60
RRF_K=60
DEFAULT_SEMANTIC_WEIGHT=0.6
# 关掉则 /api/search 的 hybrid+rrf 退化为应用侧 RRF（用于对照实验）
NATIVE_HYBRID_ENABLED=true

# ---- 服务 ----
API_HOST=0.0.0.0
API_PORT=8090
# 只读令牌；留空不校验。设置后调用方需带 Authorization: Bearer <token>
SEEKLIT_API_TOKEN=
CORS_ORIGINS=*

# ---- 路径 ----
# SEEKLIT_DATA_DIR=
# SEEKLIT_CORPUS_DIR=
# SEEKLIT_LOG_DIR=
# SEEKLIT_SNAPSHOT_DIR=

SEEKLIT_DEBUG=false
